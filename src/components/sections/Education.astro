---
import { education } from '@/data/experience';
---

<section class="section pt-0">
  <div class="container-page">
    <div class="reveal max-w-2xl">
      <p class="eyebrow mb-4">Education</p>
      <h2 class="text-display-md font-display font-bold">Academic background.</h2>
    </div>

    <div class="mt-10 grid md:grid-cols-2 gap-5">
      {education.map((e) => (
        <div class="glass p-6 reveal">
          <h3 class="font-display text-lg font-semibold">{e.school}</h3>
          <p class="text-sm text-muted mt-1">{e.degree}</p>
          <div class="mt-4 flex items-center justify-between text-xs text-muted">
            <span>{e.period}</span>
            <span class="font-mono">{e.detail}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
