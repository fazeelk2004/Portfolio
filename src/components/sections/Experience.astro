---
import { experience } from "@/data/experience";
---

<section class="section">
  <div class="container-page">
    <div class="reveal max-w-2xl">
      <p class="eyebrow mb-4">Experience</p>
      <h2 class="text-display-md font-display font-bold">
        Where I've worked and what I shipped.
      </h2>
    </div>

    <ol
      class="mt-12 relative border-l border-white/[0.08] pl-6 sm:pl-10 space-y-10"
    >
      {
        experience.map((e) => (
          <li class="reveal relative">
            <>
              <span
                class="absolute -left-[7px] sm:-left-[11px] top-2 h-3 w-3 rounded-full bg-primary
              ring-4 ring-bg"
                aria-hidden="true"
              />
              <div class="ms-2   flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
                <h3 class="font-display text-xl font-semibold">
                  {e.role} · <span class="text-muted font-normal">{e.org}</span>
                </h3>
                <span class="text-xs text-muted font-mono">{e.period}</span>
              </div>
            </>
            <p class="text-xs text-muted mt-1">{e.location}</p>
            <ul class="mt-3 space-y-2 text-sm text-muted leading-relaxed list-disc pl-4 marker:text-primary/70">
              {e.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</section>
