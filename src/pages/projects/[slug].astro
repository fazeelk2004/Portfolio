---
import Base from "@/layouts/Base.astro";
import Badge from "@/components/ui/Badge.astro";
import { projects } from "@/data/projects";
import { caseStudies } from "@/data/caseStudies";
import { profile } from "@/data/profile";
import { softwareSchema, breadcrumbSchema } from "@/utils/jsonld";
import { iconForTech } from "@/utils/techIcons";
import { Icon } from "astro-icon/components";

export function getStaticPaths() {
  return projects.map((p) => ({
    params: { slug: p.slug },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const study = caseStudies[project.slug];
const isCollab = project.ownership === "Collaborative Project";

const url = new URL(`/projects/${project.slug}`, profile.siteUrl).toString();

const jsonLd = [
  softwareSchema({
    name: project.title,
    description: project.summary,
    url,
    github: project.github,
    live: project.live,
    image: new URL(project.image, profile.siteUrl).toString(),
    tech: project.tech,
    ownership: project.ownership,
  }),
  breadcrumbSchema([
    { name: "Home", url: profile.siteUrl + "/" },
    { name: "Projects", url: profile.siteUrl + "/projects" },
    { name: project.title, url },
  ]),
];

const otherProjects = projects
  .filter((p) => p.slug !== project.slug)
  .slice(0, 3);
---

<Base
  title={project.title}
  description={project.summary}
  type="article"
  image={project.image}
  jsonLd={jsonLd}
>
  <article>
    <section class="section pb-10">
      <div class="container-page max-w-4xl">
        <div class="flex flex-wrap items-center gap-2 text-sm text-muted">
          <a href="/projects" class="link-underline hover:text-text"
            >← All projects</a
          >
          <span aria-hidden="true">·</span>
          <span>{project.year}</span>
          <span aria-hidden="true">·</span>
          <span>{project.role}</span>
        </div>

        <div class="mt-4 flex flex-wrap items-center gap-2">
          <Badge tone={isCollab ? "collab" : "owned"}>{project.ownership}</Badge
          >
          <Badge>{project.type}</Badge>
          <Badge>{project.complexity}</Badge>
        </div>

        <h1 class="mt-6 text-display-lg font-display font-bold leading-tight">
          {project.title}
        </h1>
        <p class="mt-5 text-lg text-muted leading-relaxed max-w-2xl">
          {project.summary}
        </p>

        <div class="mt-7 flex flex-wrap gap-3">
          {
            project.live && (
              <a
                href={project.live}
                target="_blank"
                rel="noopener"
                class="btn-primary"
              >
                Live App ↗
              </a>
            )
          }
          {
            project.github && (
              <a
                href={project.github}
                target="_blank"
                rel="noopener"
                class="btn-ghost"
              >
                GitHub ↗
              </a>
            )
          }
        </div>
      </div>
    </section>

    <section class="container-page max-w-5xl">
      <figure class="glass-strong overflow-hidden">
        <img
          src={project.image}
          alt={`${project.title} mockup`}
          width="1600"
          height="1000"
          class="w-full aspect-[16/10] object-cover bg-soft"
          onerror="this.style.display='none'; this.parentElement.style.background='linear-gradient(135deg,#161D2D,#0B0F19)'; this.parentElement.style.aspectRatio='16/10';"
        />
      </figure>
    </section>

    <section class="section">
      <div class="container-page max-w-3xl space-y-12">
        <div>
          <h2 class="font-display text-2xl font-bold">Tech Stack</h2>
          <ul class="mt-4 flex flex-wrap gap-2">
            {
              project.tech.map((t) => {
                const ic = iconForTech(t);
                return (
                  <li class="chip">
                    {ic && (
                      <Icon name={ic} class="h-3.5 w-3.5" aria-hidden="true" />
                    )}
                    <span>{t}</span>
                  </li>
                );
              })
            }
          </ul>
        </div>

        {
          study && (
            <>
              <div>
                <h2 class="font-display text-2xl font-bold">Problem</h2>
                <p class="mt-3 text-muted leading-relaxed">{study.problem}</p>
              </div>

              <div>
                <h2 class="font-display text-2xl font-bold">Solution</h2>
                <p class="mt-3 text-muted leading-relaxed">{study.solution}</p>
              </div>

              <div>
                <h2 class="font-display text-2xl font-bold">Features</h2>
                <ul class="mt-3 grid sm:grid-cols-2 gap-2 text-sm text-muted">
                  {study.features.map((f) => (
                    <li class="glass px-4 py-3">{f}</li>
                  ))}
                </ul>
              </div>

              <div>
                <h2 class="font-display text-2xl font-bold">Architecture</h2>
                <ul class="mt-3 space-y-2 text-muted list-disc pl-5 marker:text-primary/70">
                  {study.architecture.map((a) => (
                    <li>{a}</li>
                  ))}
                </ul>
              </div>

              {study.contribution && (
                <div>
                  <h2 class="font-display text-2xl font-bold">
                    My contribution
                  </h2>
                  <p class="mt-3 text-sm text-muted">
                    This is a collaborative project. The points below describe
                    what I worked on specifically — not the whole platform.
                  </p>
                  <ul class="mt-3 space-y-2 text-muted list-disc pl-5 marker:text-secondary/70">
                    {study.contribution.map((c) => (
                      <li>{c}</li>
                    ))}
                  </ul>
                </div>
              )}

              <div>
                <h2 class="font-display text-2xl font-bold">What I learned</h2>
                <ul class="mt-3 space-y-2 text-muted list-disc pl-5 marker:text-primary/70">
                  {study.learned.map((l) => (
                    <li>{l}</li>
                  ))}
                </ul>
              </div>
            </>
          )
        }

        <div
          class="glass-strong p-6 flex flex-wrap items-center justify-between gap-4"
        >
          <div>
            <p class="text-sm text-muted">Project highlights</p>
            <ul class="mt-2 flex flex-wrap gap-2">
              {project.highlights.map((h) => <li class="chip">{h}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="section pt-0">
      <div class="container-page">
        <h2 class="font-display text-2xl font-bold">Other projects</h2>
        <div class="mt-6 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {
            otherProjects.map((p) => (
              <a
                href={`/projects/${p.slug}`}
                class="card-hover glass p-5 hover:border-white/15 hover:-translate-y-0.5 transition-all"
              >
                <p class="text-xs text-muted">{p.type}</p>
                <p class="font-display text-lg font-semibold mt-1">{p.title}</p>
                <p class="text-sm text-muted mt-2">{p.summary}</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </article>
</Base>
