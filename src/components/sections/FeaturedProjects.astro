---
import { featuredProjects } from '@/data/projects';
import ProjectCard from '@/components/ui/ProjectCard.astro';
import Button from '@/components/ui/Button.astro';
---

<section class="section">
  <div class="container-page">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6 reveal">
      <div class="max-w-2xl">
        <p class="eyebrow mb-4">Featured Projects</p>
        <h2 class="text-display-md font-display font-bold">Selected work, ordered by depth.</h2>
        <p class="text-muted mt-4">
          Six projects that show full-stack range — from e-commerce and AI collaboration
          to business software and CRUD fundamentals.
        </p>
      </div>
      <Button href="/projects" variant="ghost" arrow>View All Projects</Button>
    </div>

    <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {featuredProjects.map((p, i) => <ProjectCard project={p} priority={i < 2} />)}
    </div>
  </div>
</section>
