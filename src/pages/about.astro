---
import Base from '@/layouts/Base.astro';
import Skills from '@/components/sections/Skills.astro';
import Experience from '@/components/sections/Experience.astro';
import Education from '@/components/sections/Education.astro';
import ContactCTA from '@/components/sections/ContactCTA.astro';
import { profile } from '@/data/profile';
import { breadcrumbSchema } from '@/utils/jsonld';

const crumbs = breadcrumbSchema([
  { name: 'Home', url: profile.siteUrl + '/' },
  { name: 'About', url: profile.siteUrl + '/about' },
]);
---

<Base
  title="About"
  description={`About ${profile.name} — Computer Science student and full-stack developer in Multan focused on practical, shippable products.`}
  jsonLd={crumbs}
>
  <section class="section">
    <div class="container-page max-w-3xl">
      <p class="eyebrow mb-4">About</p>
      <h1 class="text-display-lg font-display font-bold leading-tight">
        I'm <span class="text-gradient">Fazeel Khan</span> — a CS student turning real product
        ideas into working web applications.
      </h1>

      <div class="prose prose-invert prose-p:text-muted prose-p:leading-relaxed
        prose-headings:font-display prose-headings:tracking-tight max-w-none mt-10 space-y-6">
        <p>
          I'm a Computer Science student at Bahauddin Zakariya University in Multan,
          Pakistan, focused on full-stack web development. Most of my time goes into building
          MERN and Ruby on Rails projects with real authentication, real APIs, and real users
          in mind — not throwaway demos.
        </p>
        <p>
          My route into development came through design. Before I was writing React
          components, I was making graphics, brochures, and campaign assets. That habit
          of caring about how something looks carried over: I'd rather ship a smaller
          feature that feels considered than a bigger one that feels generic.
        </p>
        <p>
          The work I'm proudest of right now is <strong class="text-text">Golden Art Frames</strong> — a
          full MERN e-commerce platform with an in-browser product editor, Stripe checkout,
          and an admin dashboard — and my contributions to <strong class="text-text">Imagine</strong>,
          a collaborative AI fashion platform where I work on frontend and backend features
          alongside a small team.
        </p>
        <p>
          How I work: fast learner, bias toward clean code, comfortable in unfamiliar codebases,
          and pragmatic about tradeoffs. I read documentation before I guess. I ship small,
          predictable changes when I can.
        </p>
        <p>
          What I'm currently focused on: stronger MERN and Rails projects, better APIs,
          scalable UI patterns, authentication done correctly, and product work I can
          actually point to.
        </p>
        <p>
          I'm based in Multan and open to remote internships, junior full-stack roles,
          and freelance work. The fastest way to reach me is
          <a href={`mailto:${profile.email}`} class="link-underline text-secondary">{profile.email}</a>.
        </p>
      </div>
    </div>
  </section>

  <Experience />
  <Education />
  <Skills />
  <ContactCTA />
</Base>
