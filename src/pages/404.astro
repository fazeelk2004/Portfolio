---
import Base from '@/layouts/Base.astro';
---

<Base title="Page not found" description="That page doesn't exist." noindex>
  <section class="section min-h-[60vh] flex items-center">
    <div class="container-page text-center">
      <p class="font-mono text-muted text-sm">404</p>
      <h1 class="text-display-lg font-display font-bold mt-3">Page not found.</h1>
      <p class="mt-4 text-muted">The page you were looking for isn't here.</p>
      <div class="mt-8 flex justify-center gap-3">
        <a href="/" class="btn-primary">Go home</a>
        <a href="/projects" class="btn-ghost">View projects</a>
      </div>
    </div>
  </section>
</Base>
