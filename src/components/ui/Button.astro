---
interface Props {
  href?: string;
  variant?: 'primary' | 'ghost' | 'outline';
  external?: boolean;
  magnetic?: boolean;
  arrow?: boolean;
  class?: string;
}
const {
  href,
  variant = 'primary',
  external = false,
  magnetic = false,
  arrow = false,
  class: cls = '',
} = Astro.props;
const variantClass =
  variant === 'primary' ? 'btn-primary' : variant === 'ghost' ? 'btn-ghost' : 'btn-outline';
const Tag = href ? 'a' : 'button';
const linkProps = external ? { rel: 'noopener noreferrer', target: '_blank' } : {};
---

<Tag
  href={href}
  class:list={[variantClass, cls]}
  data-magnetic={magnetic ? '' : undefined}
  data-arrow={arrow ? '' : undefined}
  {...linkProps}
>
  <slot />
  {arrow && <span class="arrow" aria-hidden="true">→</span>}
</Tag>
