---
interface Props {
  tone?: 'default' | 'primary' | 'collab' | 'owned';
}
const { tone = 'default' } = Astro.props;
const map = {
  default: 'bg-white/[0.04] text-muted border-white/[0.08]',
  primary: 'bg-primary/15 text-primary border-primary/30',
  collab: 'bg-secondary/10 text-secondary border-secondary/30',
  owned: 'bg-warm/10 text-warm border-warm/30',
};
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-medium border',
    map[tone],
  ]}
>
  <slot />
</span>
