---
import { profile } from '@/data/profile';
import { projects } from '@/data/projects';
const repos = projects.filter((p) => p.github).slice(0, 6);
---

<section class="section">
  <div class="container-page">
    <div class="reveal max-w-2xl">
      <p class="eyebrow mb-4">GitHub & Project Proof</p>
      <h2 class="text-display-md font-display font-bold">Real code, public repositories.</h2>
      <p class="text-muted mt-4">
        Browse my work directly on GitHub — open repositories, commits, and project history.
      </p>
    </div>

    <div class="mt-10 grid md:grid-cols-[1.1fr_2fr] gap-5">
      <div class="glass-strong p-7 reveal flex flex-col justify-between">
        <div>
          <p class="text-xs uppercase tracking-wider text-muted">GitHub</p>
          <p class="font-display text-2xl font-bold mt-1">@{profile.githubUsername}</p>
          <p class="text-sm text-muted mt-3">
            Public projects spanning MERN, Rails, AI workflows, and business software.
            Pull Shark contributor.
          </p>
        </div>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={profile.github} target="_blank" rel="noopener" class="btn-primary">
            View GitHub Profile
          </a>
          <a
            href={`https://github.com/${profile.githubUsername}?tab=repositories`}
            target="_blank"
            rel="noopener"
            class="btn-ghost"
          >
            All Repositories
          </a>
        </div>
      </div>

      <div class="grid sm:grid-cols-2 gap-3">
        {repos.map((r) => (
          <a
            href={r.github!}
            target="_blank"
            rel="noopener"
            class="card-hover glass p-4 reveal hover:border-white/15 hover:-translate-y-0.5 transition-all"
          >
            <p class="font-medium text-text">{r.title}</p>
            <p class="text-xs text-muted mt-1 line-clamp-2">{r.summary}</p>
            <div class="mt-3 flex flex-wrap gap-1.5">
              {r.tech.slice(0, 3).map((t) => <span class="chip">{t}</span>)}
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
